# 环境配置
ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=logs

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_DATABASE=quant

# Tushare 配置
TUSHARE_TOKEN=your_tushare_token
TUSHARE_API_URL=http://api.tushare.pro
TUSHARE_TIMEOUT=30
TUSHARE_RETRY_TIMES=3

# AKShare 配置
AKSHARE_TIMEOUT=30
AKSHARE_RETRY_TIMES=3

# 回测配置
BACKTEST_INITIAL_CAPITAL=1000000
BACKTEST_COMMISSION_RATE=0.0003
BACKTEST_STAMP_DUTY=0.001
BACKTEST_SLIPPAGE=0.001
BACKTEST_MIN_TRADE_UNIT=100

# 风控配置
RISK_MAX_POSITION_PCT=0.1
RISK_MAX_INDUSTRY_PCT=0.3
RISK_MAX_TURNOVER=0.5
RISK_STOP_LOSS_PCT=0.1
